<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.genie.mapper.CategoryMapper">

    <select id="getIdByName" resultType="java.lang.Integer">
        select id from category where name = #{name}
    </select>
    <select id="selectById" resultType="com.genie.entity.Category">
select name from category where id = #{id}
    </select>
    <select id="getCategoryList" resultType="com.genie.vo.CategoryVO">
        SELECT
            id,
            name
        FROM category
        WHERE is_active = 1
        ORDER BY sort_order ASC
    </select>
</mapper>